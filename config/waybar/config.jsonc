{
  "layer": "top",
  "position": "top",
  "height": 44,
  "margin-top": 8,
  "margin-bottom": 0,
  "margin-left": 12,
  "margin-right": 12,
  "spacing": 6,

  "modules-left": ["custom/launcher", "hyprland/workspaces", "hyprland/window"],
  "modules-center": ["clock", "mpris"],
  "modules-right": ["tray", "cpu", "memory", "pulseaudio", "network", "battery", "custom/control-center"],

  "custom/launcher": {
    "format": "󰀻",
    "tooltip-format": "App Launcher (Alt+Space)",
    "on-click": "pgrep -x fuzzel >/dev/null && pkill fuzzel || fuzzel"
  },
  "hyprland/workspaces": {
    "format": "{id}",
    "on-click": "activate",
    "persistent-workspaces": { "*": 5 }
  },
  "hyprland/window": {
    "max-length": 36,
    "separate-outputs": true
  },
  "clock": {
    "format": "{:%a %b %d   %H:%M}",
    "tooltip-format": "<tt>{calendar}</tt>"
  },
  "mpris": {
    "format": "♪ {title}",
    "max-length": 24,
    "on-click": "playerctl play-pause"
  },
  "cpu": { "format": "󰻠 {usage}%" },
  "memory": { "format": "󰍛 {percentage}%" },
  "pulseaudio": {
    "format": "{icon} {volume}%",
    "format-muted": "󰝟 Muted",
    "format-icons": { "default": ["󰕿", "󰖀", "󰕾"] },
    "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
    "on-click-right": "pavucontrol"
  },
  "network": {
    "format-wifi": "󰤨 {essid}",
    "format-ethernet": "󰈀 Wired",
    "format-disconnected": "󰤭 Offline"
  },
  "battery": {
    "format": "{icon} {capacity}%",
    "format-icons": ["󰁺", "󰁼", "󰁾", "󰂀", "󰁹"]
  },
  "tray": { "spacing": 8 },
  "custom/control-center": {
    "format": "󰂚",
    "tooltip-format": "Control Center (Super+N)",
    "on-click": "swaync-client -t -sw"
  }
}
